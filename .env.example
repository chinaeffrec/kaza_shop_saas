# ============================================================
# Kaza Shop SaaS — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Lines marked [REQUIRED] MUST be set before starting in production.
# Generate random secrets: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ── Environment ──────────────────────────────────────────────
# Values: development | staging | production
# In production: secret validation is enforced at startup.
ENV=development

# ── Database ─────────────────────────────────────────────────
DB_USER=kaza_user
DB_PASSWORD=change_me_in_production        # [REQUIRED in production]
DB_HOST=db
DB_PORT=5432
DB_NAME=kaza_shop

# Optional: PgBouncer connection string (transaction mode)
# DB_PGBOUNCER_URL=postgresql+asyncpg://kaza_user:password@pgbouncer:5432/kaza_shop

# PostgreSQL streaming replica host for health checks and read offloading
# Set to db-replica when using docker-compose.prod.yml with replication enabled
DB_REPLICA_HOST=db-replica
DB_REPLICA_PORT=5432

# ── Security ─────────────────────────────────────────────────
# [REQUIRED in production] JWT signing key — min 32 chars, random hex
PLATFORM_JWT_SECRET=                       # [REQUIRED in production]

# [REQUIRED in production] Fernet encryption key for stored secrets (bot tokens, etc.)
SECRET_KEY=                                # [REQUIRED in production]

# Unused — do not populate (kept for backwards compatibility)
# ADMIN_PASSWORD=

# ── Platform super-admin (first-run seed) ────────────────────
# Used only on the very first startup to create the super-admin account.
# After seed, changing these values has no effect.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me_on_first_login

# ── Telegram ─────────────────────────────────────────────────
BOT_TOKEN=                                 # [REQUIRED] Your bot token from @BotFather
ADMIN_TG_ID=                               # Telegram user ID of the platform admin
BOT_API_TOKEN=                             # [REQUIRED] Internal token for bot→API auth (random hex)

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# Optional: Redis Sentinel for HA (comma-separated host:port list)
# REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_PASSWORD=

# ── Domain & CORS ────────────────────────────────────────────
DOMAIN=localhost                           # [REQUIRED in production] e.g. api.yourshop.com

# Allowed origins for the seller panel and mini app (comma-separated)
# [REQUIRED in production] e.g. https://seller.yourshop.com,https://app.yourshop.com
CORS_ORIGINS=http://localhost:3000

# ── Monitoring & Alerts ──────────────────────────────────────
ALERT_BOT_TOKEN=                           # Telegram bot token for alert notifications
ALERT_CHAT_ID=                             # Chat/channel ID to receive alerts

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                            # text | json (use json in production)
PROMETHEUS_ENABLED=true

# ── Timezone ─────────────────────────────────────────────────
TIMEZONE=Europe/Moscow

# ── Media storage ────────────────────────────────────────────
# "local": save to ./media/ on disk (default, single-host)
# "s3":    upload to S3-compatible bucket (enables multi-host scaling)
STORAGE_BACKEND=local

# S3 settings — required when STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.amazonaws.com        # or http://minio:9000
# S3_BUCKET=kaza-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://cdn.yourshop.com      # CDN or public bucket URL

# ── Backups ──────────────────────────────────────────────────
BACKUP_KEEP_DAYS=14
BACKUP_ENCRYPTION_KEY=             # [REQUIRED in production] AES-256 key for backup archives

# ── Error tracking & APM ─────────────────────────────────────
# Sentry: copy DSN from https://sentry.io → Project → SDK Setup
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# OpenTelemetry OTLP exporter (Grafana Tempo / Jaeger / Honeycomb / Datadog)
# Example: http://tempo:4318/v1/traces  — leave empty to disable
OTLP_ENDPOINT=
OTLP_SERVICE_NAME=kaza-shop

# ── Import limits ────────────────────────────────────────────
MEDIA_IMPORT_MAX_ARCHIVE_MB=100
MEDIA_IMPORT_MAX_FILES=2000
MEDIA_IMPORT_MAX_UNCOMPRESSED_MB=500

# ── JWT TTL ──────────────────────────────────────────────────
ACCESS_TOKEN_TTL=3600        # seconds (default: 1 hour)
REFRESH_TOKEN_TTL=2592000    # seconds (default: 30 days)
